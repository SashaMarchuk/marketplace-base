#!/bin/sh
# marketplace-base pre-push hook (SPEC section 16, step 4). Installed by `./mb github setup` with
# `git config core.hooksPath tools/hooks` when GitHub branch rules are not available (for example
# GitHub Free private repos), so the same gates run locally before every push:
#   ./mb check --fast   (all fast rules, including the CHK-20 leak scan)
#   ./mb gen --check    (generated files are up to date)
# The checks run on the working tree. Skip once with `git push --no-verify` (CI still runs them).
# Remove with `git config --unset core.hooksPath`.

top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so ./mb cannot run; install Node >= 20 or push with --no-verify" >&2
  exit 1
fi

status=0
node tools/mb.mjs check --fast || status=1
node tools/mb.mjs gen --check || status=1
if [ "$status" -ne 0 ]; then
  echo "pre-push: blocked by ./mb check --fast / ./mb gen --check (fix the errors above, or push with --no-verify)" >&2
fi
exit "$status"
