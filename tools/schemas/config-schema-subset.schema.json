{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-schema-subset.schema.json",
  "title": "marketplace-base config.schema.json subset",
  "description": "A plugin's config.schema.json may use only these keywords (SPEC 9): type, enum, properties, items, minimum, maximum, maxLength. $schema, title and description are allowed as annotations only. The merge core never reads the schema; `resolve.mjs set` and CHK-11/12 do.",
  "$ref": "#/$defs/node",
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["object", "array", "string", "integer", "number", "boolean", "null"] },
        "enum": { "type": "array" },
        "properties": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "items": { "$ref": "#/$defs/node" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "maxLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
