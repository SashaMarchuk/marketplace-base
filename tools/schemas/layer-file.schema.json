{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer-file.schema.json",
  "title": "marketplace-base config layer file",
  "description": "Shape of every config layer (SPEC 6.2). Closed levels: top, plugins.<p>, enforced, enforced.plugins.<p>. Contents of every settings object are free-form. Which layer may use enforced/team/merge, and the config-text lexical rules (integer-only numbers, key syntax, no BOM, no lone surrogates, no __proto__/constructor/prototype, no duplicate keys), are enforced by the parser and the resolver, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "settings": { "$ref": "#/$defs/settings" },
    "plugins": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/pluginName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "settings": { "$ref": "#/$defs/settings" }
        }
      }
    },
    "enforced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": { "$ref": "#/$defs/settings" },
        "plugins": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/pluginName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "settings": { "$ref": "#/$defs/settings" }
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "$ref": "#/$defs/accessPattern" } },
        "deny": { "type": "array", "items": { "$ref": "#/$defs/accessPattern" } }
      }
    },
    "team": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowGenerated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "pluginName": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "accessPattern": { "type": "string", "pattern": "^[a-z0-9*][a-z0-9*-]{0,63}$" },
    "settings": {
      "description": "Free-form settings object. Keys must match ^[A-Za-z0-9_-]{1,64}$ at every depth (checked by the parser).",
      "type": "object"
    }
  }
}
